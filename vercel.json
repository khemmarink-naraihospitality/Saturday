{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "saturdaycom.vercel.app"
                }
            ],
            "destination": "https://saturday.naraihospitalitygroup.com/$1",
            "permanent": true
        },
        {
            "source": "/favicon.ico",
            "destination": "https://guideline.lubd.com/wp-content/uploads/2025/11/NHG128.png",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
