{
    "functions": {
        "api/**/*.ts": {
            "maxDuration": 60,
            "memory": 1024
        },
        "api/**/*.js": {
            "maxDuration": 60,
            "memory": 1024
        }
    },
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "saturdaycom.vercel.app"
                }
            ],
            "destination": "https://saturday.naraihospitalitygroup.com/$1",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}